{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Workspace packages import with explicit .ts extensions (repo-wide
    // style); tsc follows those imports across package boundaries, so the
    // app's own typecheck must allow them. Safe under --noEmit.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "uniwind-env.d.ts"]
}
